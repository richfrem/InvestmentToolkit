graph TD
    %% Nodes - Feature Level (Start)
    Start(("Start Feature<br>(Start)"))
    Specify["fa:fa-file-alt Specify Feature<br>(Cmd: spec-kitty specify)"]
    Plan["fa:fa-map Plan & Tasks<br>(Cmd: spec-kitty plan / tasks)"]
    
    %% Nodes - WP Level (Loop)
    subgraph WP_Loop["WP Execution Loop (Repeated per WP)"]
        Implement["fa:fa-tools Start WP<br>(Cmd: spec-kitty implement WP-xx)<br>(Creates: .worktrees/WP-xx)"]
        Code["fa:fa-code Code & Test<br>(Context: Inside Worktree)"]
        Commit["fa:fa-save Git Commit (Local)<br>(git commit -m 'feat...')"]
        MoveReview["fa:fa-arrow-right Move to Review<br>(Cmd: spec-kitty tasks update WP-xx --lane for_review)"]
        Review["fa:fa-glasses Review WP<br>(Cmd: spec-kitty review WP-xx)<br>(Moves to 'Done')"]
    end

    %% Nodes - Feature Level (End)
    subgraph Closure["Feature Completion (Deterministic Closure Protocol)"]
        direction TB
        CL_Review@{ label: "Review WPs<br><b style='color:#1E90FF'>/spec-kitty.review</b>" }
        CL_Accept@{ label: "Accept Feature<br><b style='color:#1E90FF'>/spec-kitty.accept</b>" }
        CL_Retro@{ label: "Retrospective (MANDATORY)<br><b style='color:#FF8C00'>/spec-kitty_retrospective</b>" }
        CL_Merge@{ label: "Merge from Main Repo<br><b style='color:#1E90FF'>/spec-kitty.merge</b> --feature slug" }
        CL_PostVerify@{ label: "Post-Merge Verify<br>git worktree list, git branch" }
        CL_IntelSync@{ label: "Intelligence Sync<br>RLM/Vector Update" }
        CL_End["Feature Done (Clean Repo)"]
        CL_Review --> CL_Accept --> CL_Retro --> CL_Merge --> CL_PostVerify --> CL_IntelSync --> CL_End
    end

    style CL_Retro fill:#FFD700
    style CL_End fill:#90EE90

    %% Flow
    Start --> Specify
    Specify --> Plan
    Plan --> Implement
    
    %% Loop Logic
    Implement -->|cd .worktrees/WP-xx| Code
    Code --> Commit
    Commit --> MoveReview
    MoveReview --> Review
    
    %% Iterate or Finish
    Review -->|Next WP?| Implement
    Review -->|All WPs Done?| Accept
    
    %% Finalization
    Review -->|All WPs Done?| CL_Review

    %% Styles
    classDef feature fill:#e3f2fd,stroke:#1565c0,stroke-width:2px;
    classDef wp fill:#fff3e0,stroke:#ef6c00,stroke-width:2px;
    classDef done fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px;

    class Specify,Plan feature;
    class Implement,Code,Commit,MoveReview,Review wp;
