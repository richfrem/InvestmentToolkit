//@version=6
// AI TA Levels v3 — Streamlined Multi-EMA Stack + Silent Data Window Engine
// Purpose: Provides clean, uncluttered 21/50/200 EMA trend lines on chart while
// silently exposing precise numerical indicators (ADX, ATR, Vol Bias %, Trailing Stop)
// in the TradingView Data Window for AI CDP consumption.
//
// Layer: Codify / TradingView Pine Script Suite
indicator("AI TA Levels v3", shorttitle="AI-TA", overlay=true)

// ── Inputs ─────────────────────────────────────────────────────────────────
ema_fast   = input.int(21,   "Fast EMA",    minval=1,   group="EMA Stack")
ema_mid    = input.int(50,   "Mid EMA",     minval=1,   group="EMA Stack")
ema_slow   = input.int(200,  "Slow EMA",    minval=1,   group="EMA Stack")
vol_len    = input.int(20,   "Volume MA",   minval=1,   group="Volume Bias")
adx_len    = input.int(14,   "ADX Length",  minval=1,   group="Trend Strength")
atr_len    = input.int(14,   "ATR Length",  minval=1,   group="Volatility")
st_factor  = input.float(3.0,"Trailing ATR Factor", step=0.5, group="Trailing Stop")

// ── EMA Calculations ────────────────────────────────────────────────────────
e_fast = ta.ema(close, ema_fast)
e_mid  = ta.ema(close, ema_mid)
e_slow = ta.ema(close, ema_slow)

// ── Volume Bias % (Accumulation vs Distribution) ────────────────────────────
bull_vol = close > open ? volume : 0.0
bear_vol = close <= open ? volume : 0.0
bull_ma  = ta.sma(bull_vol, vol_len)
bear_ma  = ta.sma(bear_vol, vol_len)
bias_pct = (bull_ma - bear_ma) / (bull_ma + bear_ma + 0.001) * 100

// ── ADX / Trend Strength ─────────────────────────────────────────────────────
[di_plus, di_minus, adx_val] = ta.dmi(adx_len, adx_len)

// ── ATR & Trailing Stop Math ────────────────────────────────────────────────
atr_val = ta.atr(atr_len)
[st_val, st_dir] = ta.supertrend(st_factor, 10)

// ── Overlay Plots (Clean Institutional Lines) ────────────────────────────────
plot(e_fast, "EMA 21",  color=color.new(color.yellow, 10), linewidth=1)
plot(e_mid,  "EMA 50",  color=color.new(color.orange, 10), linewidth=2)
plot(e_slow, "EMA 200", color=color.new(color.white, 10),  linewidth=2)

// ── Silent Data Window Exports (AI CDP Readout — Zero Chart Clutter) ─────────
plot(bias_pct, "Vol Bias %",     display=display.data_window, color=color.new(color.aqua, 0))
plot(adx_val,  "ADX",            display=display.data_window, color=color.new(color.purple, 0))
plot(atr_val,  "ATR",            display=display.data_window, color=color.new(color.silver, 0))
plot(st_val,   "Trailing Stop",  display=display.data_window, color=color.new(color.teal, 0))
plot(di_plus,  "DI+",            display=display.data_window, color=color.new(color.lime, 0))
plot(di_minus, "DI-",            display=display.data_window, color=color.new(color.red, 0))
