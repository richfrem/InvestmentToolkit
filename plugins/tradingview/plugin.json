{
  "name": "tradingview",
  "version": "1.2.0",
  "description": "TradingView Desktop integration via CDP \u2014 real-time prices, DCF alerts, chart snapshots, portfolio sync, live order execution, chart control (add/remove indicators, timeframe, symbol, Data Window read), Pine Script v6 authoring (lint, inject, save), deep TA, and daily batch TA sweep (/ta-daily-sweep) across all portfolio holdings. Results auto-saved to ta-sweep-results.json.",
  "author": "InvestmentToolkit",
  "maturity": "L3",
  "architecture": "standard",
  "runtime_dependencies": [
    {
      "name": "tradingview-cdp",
      "description": "Node.js CDP engine for browser automation of TradingView Desktop",
      "type": "node-package",
      "expected_path": "tradingview-cdp/",
      "relative_to": "project_root",
      "marker_file": "cli.js",
      "setup_command": "cd tradingview-cdp && npm ci",
      "env_override": "TV_CDP_DIR",
      "health_check": "node tradingview-cdp/cli.js health",
      "required": true,
      "required_by_skills": [
        "price-refresh",
        "cancel-order",
        "place-order",
        "modify-order",
        "get-orders",
        "chart-snapshot",
        "pine-inject",
        "alert-sync",
        "ta-snapshot",
        "ta-red-team",
        "technical-analysis-expert",
        "tv-portfolio-sync",
        "ta-daily-sweep",
        "tv-manage-watchlists"
      ],
      "notes": [
        "TradingView Desktop must be running with --remote-debugging-port=9222",
        "Node.js 18+ required",
        "See plugins/tradingview/README.md for full setup instructions"
      ]
    }
  ],
  "system_dependencies": [
    {
      "name": "node",
      "minimum_version": "18.0.0",
      "check_command": "node --version"
    },
    {
      "name": "TradingView Desktop",
      "launch_flag": "--remote-debugging-port=9222",
      "default_port": 9222
    }
  ],
  "skills": [
    {
