        },
        {
            "name": "persist_projection.py",
            "canonical_path": "tools/investment_screener/backend/py_services/persist_projection.py",
            "owned_by": "investment-screener-app",
            "purpose": "Saves projection JSON to the data directory"
        }
    ],
    "related_plugins": [
        "thesis-balancer"
    ],
    "tags": [
        "finance",
