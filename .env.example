# ============================================================
# INVESTMENT TOOLKIT CONFIGURATION
# ============================================================

# --- Infrastructure ---
BACKEND_PORT=3001
FRONTEND_PORT=5173

# --- TradingView Desktop CDP (Optional, for Live Prices & Order Execution) ---
# Launch TradingView Desktop with: /Applications/TradingView.app/Contents/MacOS/TradingView --remote-debugging-port=9222
TV_CDP_PORT=9222

# --- Diagnostics ---
# Logging level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO
DEBUG_LOGGING=false

# --- AI & LLM Integrations (Optional) ---
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
# GROQ_API_KEY=your_groq_key_here
