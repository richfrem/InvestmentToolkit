# ============================================================
# INVESTMENT TOOLKIT CONFIGURATION
# ============================================================

# --- Brokerage: Questrade ---
# Personal apps use simplified token flow - NO client_id/secret required.
# DO NOT put your actual token here. The system uses a secure encrypted cache.
# Setup: Launch CLI agent and type "Help me set up the toolkit"

# --- Infrastructure ---
BACKEND_PORT=3001
FRONTEND_PORT=5173

# --- External Data APIs ---
# Exchange Rate API (https://app.exchangerate-api.com/)
EXCHANGE_RATE_API_KEY=your_api_key_here

# --- Localization & Defaults ---
USD_CAD_EXCHANGE_RATE=1.40460

# --- Diagnostics ---
# Logging level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO
DEBUG_LOGGING=false

# --- AI Agents & OS ---
# Primary AI analysis is performed via CLI Environment (Gemini CLI, Claude Code, etc.)
# Requirement: Pro-tier subscription (Claude 3.5 Sonnet, Gemini 1.5 Pro, or Copilot Pro)
# No API keys required in .env for Agentic OS workstation features.

# --- Browser Harness (browser automation for Grok sweeps) ---
# Clone: git clone https://github.com/browser-use/browser-harness ~/projects/browser-harness
# Docs: ~/projects/browser-harness/domain-skills/grok/post.md
BROWSER_HARNESS_DIR=~/projects/browser-harness
# Port used for the debug Chrome instance (9223 avoids conflict with TradingView on 9222)
BROWSER_HARNESS_CDP_PORT=9223
