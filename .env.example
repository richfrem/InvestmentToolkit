# ============================================================
# INVESTMENT TOOLKIT CONFIGURATION
# ============================================================

# --- Infrastructure ---
BACKEND_PORT=3001
FRONTEND_PORT=5173

# --- TradingView Desktop CDP (Optional, for Live Prices & Order Execution) ---
# Launch TradingView Desktop with: /Applications/TradingView.app/Contents/MacOS/TradingView --remote-debugging-port=9222
TV_CDP_PORT=9222

# --- Broker connections ---
# TradingView is the default source for positions and executed trades and needs no setting.
# Set to true only if you also use Questrade and completed /questrade-setup: refreshes will then
# ask which source to use (TradingView stays the default). Leave false to use TradingView only.
QUESTRADE_ENABLED=false

# --- Browser Harness (optional; browser automation for Grok sweeps in news_sweep.py) ---
# Clone: git clone https://github.com/richfrem/browser-harness ~/projects/browser-harness
# The sweep uses Chrome with --remote-debugging-port=9223 (9223 avoids a clash with TradingView on 9222).
# BROWSER_HARNESS_DIR=~/projects/browser-harness

# --- Diagnostics ---
# Logging level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO
DEBUG_LOGGING=false

# --- AI & LLM Integrations (Optional) ---
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
# GROQ_API_KEY=your_groq_key_here
