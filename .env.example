# Questrade API Credentials
# Obtain from Questrade Developer Portal: https://www.questrade.com/api
# Manual flow: Generate token in API Centre, redeem via:
# https://login.questrade.com/oauth2/token?grant_type=refresh_token&refresh_token=<TOKEN>

QUESTRADE_CLIENT_ID=your_client_id_here
QUESTRADE_CLIENT_SECRET=your_client_secret_here

# After redeeming, fill these:
QUESTRADE_ACCESS_TOKEN=your_access_token_here
QUESTRADE_API_SERVER=https://api01.iq.questrade.com/
QUESTRADE_REFRESH_TOKEN=your_refresh_token_here

# Optional: Database URL for Prisma (SQLite for local dev)
DATABASE_URL="file:./dev.db"