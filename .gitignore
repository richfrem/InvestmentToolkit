logs/
temp/logs/
*.log

# IDE
.vscode/
.idea/
*.bak

# OS
.DS_Store
Thumbs.db

# Build outputs
dist/
build/

# Temporary files
temp/
*.tmp
*.temp

# Sensitive account and portfolio data (DO NOT COMMIT)
# Excluded via sparse-checkout or local-only
.env
.env.*
investment_screener/backend/data/portfolio-config.json
investment_screener/backend/data/portfolio_tv.json
plugins/portfolio-advisor/references/portfolio.json

# Personal workspace — generated outputs, order screenshots, review artifacts
PortfolioAnalysis/
.questrade_cache
**/.questrade_cache

# folders to ignore
kittywindsurf/
kittyclaude/
kittycopilot/
kittygemini/
archive/
# Exception: the research corpus migration's archive dir (ADRs/026-028) holds the
# only copy of the original dated research files moved (not deleted) by the
# migration — must be tracked, not caught by the generic archive/ rule above.
!investment_screener/backend/data/research/archive/
# Exception: repo-root retirement archive (formerly "kept locally, never
# tracked" — reversed so retired content has git-history durability instead
# of existing only on local disk, same rationale as the exception above).
# Case-insensitive filesystems (default macOS) match this against the
# bare "archive/" rule too, so it needs its own explicit negation.
!ARCHIVE/
InvestmentStrategy/
.claude/
.agents/
.codex/
.opencode/
.windsurf/
.gemini/
.cursor/
.qwen/
.kilocode/
.augment/
.roo/
.amazonq/
.github/copilot/
.kittify/.dashboard

# Research artifacts
kitty-specs/**/tasks/*.md

# Backend cache
investment_screener/backend/py_services/cache/
investment_screener/backend/data/cache/

# Intelligence read-model DB (derived/rebuildable from observations.jsonl, never committed — ADRs/026-028)
investment_screener/backend/data/intelligence.sqlite
investment_screener/backend/data/intelligence.sqlite-wal
investment_screener/backend/data/intelligence.sqlite-shm

# Domain-model DB (derived/rebuildable from projections/*.json etc., never committed — ADR-029, Wave 1 Task 4)
investment_screener/backend/data/domain_model.sqlite
investment_screener/backend/data/domain_model.sqlite-wal
investment_screener/backend/data/domain_model.sqlite-shm

# Runtime secrets (generated at startup, never committed)
.runtime/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Personal trading data (user-specific, cannot be recovered from git)
investment_screener/backend/data/trade-log.json
investment_screener/backend/data/portfolio.json
investment_screener/backend/data/cash_flows.json
investment_screener/backend/data/orders_executed.jsonl

# Daily brief snapshots (personal — generated daily, not for version control)
investment_screener/backend/data/daily-briefs/

# TradingView order audit logs (runtime output, rotated daily)
plugins/tradingview/audit/

# Re-ignore ARCHIVE/ mirrors of the private/gitignored domains above -- the
# blanket `!ARCHIVE/` negation earlier in this file otherwise un-ignores
# everything under ARCHIVE/, including archived copies of data that must
# stay local-only per each migration wave's Private/Gitignored File Archive
# Rule (spec §2.19: archived via local `mv`, never `git add`ed, privacy
# boundary preserved). Found 2026-07-25 after 11 real daily-briefs JSON
# files were accidentally committed and pushed via `git add .` -- they were
# untracked-but-visible because nothing re-excluded this specific subpath.
ARCHIVE/investment_screener/backend/data/daily-briefs/
ARCHIVE/investment_screener/backend/data/portfolio.json
ARCHIVE/investment_screener/backend/data/cash_flows.json
ARCHIVE/investment_screener/backend/data/orders_executed.jsonl
ARCHIVE/investment_screener/backend/data/trade-log.json

.pytest_cache/
**/.pytest_cache/

# Python file locks (created by pip-compile; never committed)
*.pylock

# Triage session history (ephemeral daily agent state)
plugins/portfolio-advisor/references/triage-history.json

# Local git worktrees for isolated feature work
.worktrees/

# superpowers subagent-driven-development scratch state (progress ledger)
.superpowers/
